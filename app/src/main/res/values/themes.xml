<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MediGo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/medigo_primary</item>
        <item name="colorPrimaryDark">@color/medigo_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/medigo_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/medigo_primary</item>
        <item name="android:windowBackground">@color/background_primary</item>
    </style>

    <style name="Theme.MediGo.Splash" parent="Theme.MediGo">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/medigo_primary</item>
    </style>

    <style name="MediGoButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/medigo_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MediGoButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/medigo_primary</item>
        <item name="strokeColor">@color/medigo_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MediGoTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/medigo_primary</item>
        <item name="hintTextColor">@color/medigo_primary</item>
    </style>

    <style name="TextAppearance.MediGo.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontWeight" tools:targetApi="26">700</item>
    </style>

    <style name="TextAppearance.MediGo.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="MediGoCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

</resources>